# ===============================================================
#  OdinDoc - configurazione per un cliente
#  Copia questo file (es. acme.properties) e adatta i percorsi.
#  Ogni valore si può anche passare da riga di comando: --chiave=valore
#  Su Windows usa / oppure \\ nei percorsi.
# ===============================================================

titolo=Gestione Vendite
cliente=ACME S.p.A.

# Cartella (o più cartelle separate da ;) con gli script DDL: .sql .ddl .tab .vw .trg .pks .pkb ...
ddl=C:/clienti/acme/db

# Cartella (o più cartelle separate da ;) con i sorgenti Java
src=C:/clienti/acme/progetto/src/main/java

# Cartella delle descrizioni scritte a mano o dall'AI (consigliato: sotto git insieme al progetto)
descrizioni=C:/clienti/acme/documentazione/descrizioni

# File prodotti
output=C:/clienti/acme/documentazione/documentazione.pdf
pacchetto=C:/clienti/acme/documentazione/da-descrivere.md

# Quanti elementi al massimo per pacchetto (0 = tutti). Utile per non dare troppo lavoro all'AI in un colpo solo.
pacchetto.max=0

# Includere anche le cartelle /test/ ?
includi.test=false

# ---------------------------------------------------------------
#  Database (FACOLTATIVO): serve solo a leggere i DATI, la struttura arriva dalle DDL.
#  Lascia db.url vuoto per non collegarti.
# ---------------------------------------------------------------
db.url=
#db.url=jdbc:oracle:thin:@//server:1521/SERVIZIO
db.utente=LETTORE
# Meglio NON scrivere la password qui: se manca la chiede all'avvio,
# oppure la legge dalla variabile d'ambiente ODINDOC_DB_PASSWORD
#db.password=
db.driver.jar=C:/drivers/ojdbc11.jar
# Oltre questo numero di righe conta solo le righe (niente analisi delle colonne)
db.soglia.righe=2000000
# Tabelle da non leggere (dati personali, ecc.), separate da virgola
db.escludi=
# Secondi massimi per ogni query
db.timeout=60
